public class Solution
{
    public int[] SortArrayByParity(int[] nums)
    {
        int left = 0;
        int right = nums.Length - 1;

        while (left < right)
        {
            if (nums[left] % 2 == 0)
            {
                left++;
            }
            else if (nums[right] % 2 != 0)
            {
                right--;
            }
            else
            {
                int temp = nums[left];
                nums[left] = nums[right];
                nums[right] = temp;

                left++;
                right--;
            }
        }

        return nums;
    }
}



