public class Solution
{
    public int Search(int[] nums, int target)
    {
        int lo = 0;
        int hi = nums.Length;

        while (lo < hi)
        {
            int mid = lo + (hi - lo) / 2;

            if (nums[mid] == target)
            {
                return mid;
            }
            else if (nums[mid] < target)
            {
                lo = mid + 1;
            }
            else
            {
                hi = mid;
            }
        }

        return -1;
    }
}



